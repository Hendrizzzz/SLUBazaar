<div class="listings-container">
    <h1>Listing Management</h1>
    
    <div class="filters">
        <form method="GET" class="filter-form">
            <input type="text" name="search" placeholder="Search listings..." value="<%= searchQuery || '' %>">
            <select name="status">
                <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Listings</option>
                <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Active</option>
                <option value="sold" <%= statusFilter === 'sold' ? 'selected' : '' %>>Sold</option>
                <option value="removed" <%= statusFilter === 'removed' ? 'selected' : '' %>>Removed</option>
            </select>
            <button type="submit">Filter</button>
        </form>
    </div>
    
    <div class="listings-table">
        <% if (listings && listings.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Seller</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Current Bid</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% listings.forEach(listing => { %>
                        <tr>
                            <td><%= listing.title %></td>
                            <td><%= listing.sellerId %></td>
                            <td>
                                <span class="status-badge <%= listing.itemStatus %>">
                                    <%= listing.itemStatus %>
                                </span>
                            </td>
                            <td><%= new Date(listing.createdAt).toLocaleDateString() %></td>
                            <td>$<%= listing.currentBid || '0.00' %></td>
                            <td>
                                <% if (listing.itemStatus === 'Active') { %>
                                    <button class="remove-btn" data-listing-id="<%= listing.itemId %>">Remove</button>
                                <% } else if (listing.itemStatus === 'Removed') { %>
                                    <button class="restore-btn" data-listing-id="<%= listing.itemId %>">Restore</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p>No listings found.</p>
        <% } %>
    </div>
</div>