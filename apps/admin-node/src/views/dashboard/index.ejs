<!DOCTYPE html>

<!--mini cards -->
<!--mini cards padding -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <!--active listings -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 mb-2">Active Listings</h3>
       
        <p class="text-4xl font-bold text-gray-900"> <%= metrics.activeListings || 0 %></p>
    </div>

    <!-- closed listings -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 mb-2">Closed Listings</h3>
        <p class="text-4xl font-bold text-gray-900"><%= metrics.closedListings || 0 %></p>
    </div>

    <!--total users -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 mb-2">Total Users</h3>
        <p class="text-4xl font-bold text-gray-900"><%= metrics.totalUsers || 0 %></p>
    </div>

    <!--sold items -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 mb-2">Sold</h3>
        <p class="text-4xl font-bold text-gray-900"><%= metrics.soldItems || 0 %></p>
    </div>

    <!--reported listings -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 mb-2">Reported Listings</h3>
        <p class="text-4xl font-bold text-gray-900"><%= metrics.reportedListings || 0 %></p>
    </div>

    <!--reported users -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-700 mb-2">Reported Users</h3>
        <p class="text-4xl font-bold text-gray-900"><%= metrics.reportedUsers || 0 %></p>
    </div>
</div>