<div class="dashboard-container">
    <h1>Admin Dashboard</h1>
    
    <div class="stats-grid">
      
        <div class="stat-card pending-reports">
            <div class="card-header">
               
                <h3>Pending Reports</h3>
            </div>
            <div class="card-body">
                <span class="stat-number"><%= metrics.pendingReports || 0 %></span>
            </div>
        </div>

        <div class="stat-card reported-users">
            <div class="card-header">
                <h3>Reported Users</h3>
            </div>
            <div class="card-body">
                <span class="stat-number"><%= metrics.reportedUsers || 0 %></span>
            </div>
        </div>
        
        
        <div class="stat-card active-users">
            <div class="card-header">
          
                <h3>Active Users</h3>
            </div>
            <div class="card-body">
                <span class="stat-number"><%= metrics.activeUsers || 0 %></span>
            </div>
        </div>
        
    
        <div class="stat-card active-listings">
            <div class="card-header">
                <h3>Active Listings</h3>
            </div>
            <div class="card-body">
                <span class="stat-number"><%= metrics.activeListings || 0 %></span>
            </div>
        </div>
    </div>
    
    <div class="stats-grid">
        <div class="stat-card sold-items">
            <div class="card-header">
                <h3>Sold Items</h3>
            </div>
            <div class="card-body">
                <span class="stat-number"><%= metrics.soldItems || 0 %></span>
            </div>
        </div>
    </div>
    
    <div class="stats-grid">
        <div class="stat-card closed-listings">
            <div class="card-header">
                <h3>Closed Listings</h3>
            </div>
            <div class="card-body">
                <span class="stat-number"><%= metrics.closedListings || 0 %></span>
            </div>
        </div>
    </div>


    <div class="recent-activity">
        <h2>Recent Activity</h2>
        <div class="activity-feed">
            <p>No recent activity to display.</p>
        </div>
    </div>
</div>