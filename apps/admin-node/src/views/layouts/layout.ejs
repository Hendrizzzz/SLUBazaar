<% 
if (typeof activeTab === 'undefined') {
    activeTab = '';
}
if (typeof title === 'undefined') {
    title = 'Admin Hub';
}
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Admin' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-50">
    <!--bg img setup -->
    <div class="fixed inset-0 bg-center bg-cover -z-10"
         style="background-image: url('/SLUBazaar/apps/admin-node/public/assets/slubakakeng.png')">
    </div>

    <div class="min-h-screen p-4 md:p-6">
        <!--top left items (header)-->
        <header class="flex items-center gap-4 mb-6">
            <img src="/SLUBazaar/apps/admin-node/public/assets/SLU Logo.png"
                 alt="slu_logo"
                 class="w-12 h-12 md:w-16 md:h-16 object-contain" />
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-white drop-shadow">
                    SLU Bazaar
                </h1>
                <p class="text-base md:text-lg text-white/90">
                    Admin Overview
                </p>
            </div>
        </header>

        <!--main card-->
        <main class="flex justify-center">
            <section class="w-full max-w-6xl bg-white/95 backdrop-blur-sm rounded-2xl shadow-xl overflow-hidden min-h-[600px]">
                <!-- card tabs for page navi -->
                <nav class="border-b">
                    <div class="flex flex-wrap gap-1 px-6 pt-4">
                        <a href="/admin/dashboard"
                           class="inline-flex items-center px-5 py-3 rounded-t-lg font-medium transition-all duration-200
                           <%= activeTab === 'overview'
                               ? 'bg-blue-600 text-white border border-blue-600'
                               : 'text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 hover:border-gray-400' %>">
                            Overview
                        </a>
                        <a href="/admin/report"
                           class="inline-flex items-center px-5 py-3 rounded-t-lg font-medium transition-all duration-200
                           <%= activeTab === 'users'
                               ? 'bg-blue-600 text-white border border-blue-600'
                               : 'text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 hover:border-gray-400' %>">
                            Reports
                        </a>
                        <a href="/admin/users"
                           class="inline-flex items-center px-5 py-3 rounded-t-lg font-medium transition-all duration-200
                           <%= activeTab === 'listings'
                               ? 'bg-blue-600 text-white border border-blue-600'
                               : 'text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 hover:border-gray-400' %>">
                            Users
                        </a>
                         <a href="/admin/listings"
                           class="inline-flex items-center px-5 py-3 rounded-t-lg font-medium transition-all duration-200
                           <%= activeTab === 'listings'
                               ? 'bg-blue-600 text-white border border-blue-600'
                               : 'text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 hover:border-gray-400' %>">
                            Listings
                        </a>
                    </div>
                </nav>

                <!--page content - to be filled by dashboard\index.ejs -->
                <div class="p-6 md:p-8">
                    <%- body %>
                </div>
            </section>
        </main>
    </div>
</body>
</html>