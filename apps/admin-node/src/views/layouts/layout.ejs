<% if (typeof activeTab==='undefined' ) { activeTab='' ; } if (typeof title==='undefined' ) { title='Admin Hub' ; } %>

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title || 'Admin' %>
        </title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['Outfit', 'sans-serif'],
                        },
                        colors: {
                            slu: {
                                blue: '#0056b3', // Approximate match for the screenshot blue
                                light: '#4aa3f0',
                                accent: '#d4e157' // The lime/greenish accent
                            }
                        }
                    }
                }
            }
        </script>
        <style>
            body {
                font-family: 'Outfit', sans-serif;
            }

            /* Custom diagonal background */
            .slu-bg {
                background: linear-gradient(135deg, #2b6cb0 0%, #2b6cb0 35%, #9cbd3c 35.1%, #9cbd3c 100%);
                background-attachment: fixed;
            }

            /* Glassmorphism for the main card */
            .glass-panel {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
            }
        </style>
    </head>

    <body class="min-h-screen slu-bg">

        <div class="min-h-screen flex flex-col">
            <!-- Header -->
            <header class="w-full px-6 py-4 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <img src="assets/SLU Logo.png" alt="slu_logo" class="w-12 h-12 object-contain drop-shadow-md" />
                    <div class="text-white">
                        <h1 class="text-2xl font-bold leading-tight">SLU Bazaar</h1>
                        <p class="text-xs opacity-90">Admin Administration</p>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <!-- Logout Button -->
                    <a href="/index.php?action=logout"
                        class="text-white/80 hover:text-white text-xs font-medium uppercase tracking-wider transition-colors">
                        Logout
                    </a>

                    <!-- User Avatar Placeholder (Admin) -->
                    <div
                        class="h-10 w-10 rounded-full bg-white/20 flex items-center justify-center text-white font-bold border border-white/30 cursor-pointer hover:bg-white/30 transition">
                        A
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="flex-grow px-4 md:px-8 py-6 flex justify-center items-start">
                <section
                    class="w-full max-w-7xl glass-panel rounded-xl shadow-2xl overflow-hidden min-h-[700px] flex flex-col">

                    <!-- Navigation Tabs (Styled like the screenshot's top bar) -->
                    <nav class="bg-white/50 border-b border-gray-100 px-6 pt-4 flex gap-6 overflow-x-auto">
                        <a href="/admin/dashboard"
                            class="pb-3 border-b-2 font-medium text-sm transition-all whitespace-nowrap
                       <%= activeTab === 'overview' ? 'border-blue-600 text-blue-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
                            Overview
                        </a>
                        <a href="/admin/reports"
                            class="pb-3 border-b-2 font-medium text-sm transition-all whitespace-nowrap
                       <%= activeTab === 'reports' ? 'border-blue-600 text-blue-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
                            Reports
                        </a>
                        <a href="/admin/users"
                            class="pb-3 border-b-2 font-medium text-sm transition-all whitespace-nowrap
                       <%= activeTab === 'users' ? 'border-blue-600 text-blue-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
                            Users (Members)
                        </a>
                        <a href="/admin/listings"
                            class="pb-3 border-b-2 font-medium text-sm transition-all whitespace-nowrap
                       <%= activeTab === 'listings' ? 'border-blue-600 text-blue-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
                            Listings
                        </a>
                    </nav>

                    <!-- Page Content -->
                    <div class="p-6 md:p-8 flex-grow bg-gray-50/50" id="content-area">
                        <%- body %>
                    </div>

                </section>
            </main>

            <footer class="text-center py-4 text-white/60 text-xs">
                &copy; 2025 SLU Bazaar Admin
            </footer>
        </div>
    </body>

    </html>